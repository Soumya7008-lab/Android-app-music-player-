<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Theme -->
    <style name="Theme.MyApplication" parent="android:Theme.Material.NoActionBar" />

    <!-- Splash Themes with true Edge-to-Edge support and Image Backgrounds -->
    <style name="Theme.MyApplication.Splash.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="Theme.MyApplication.Splash.Light" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>


</resources>





