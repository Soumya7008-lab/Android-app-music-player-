<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Drop Shadow for the Note -->
    <path
        android:pathData="M38,72 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 M52,72 L52,37 L72,37 L72,50 L52,50"
        android:fillColor="#88000000" />

    <!-- 3D Side Shadow (Thickness) -->
    <path
        android:pathData="M37,71 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 M51,71 L51,36 L71,36 L71,49 L51,49"
        android:fillColor="#A0A0A0" />

    <!-- Main Metallic Body -->
    <path
        android:pathData="M36,70 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 M50,70 L50,35 L70,35 L70,48 L50,48">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="35"
                android:endX="70"
                android:endY="82"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0" />
                <item android:color="#BDBDBD" android:offset="0.5" />
                <item android:color="#E0E0E0" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top Highlight -->
    <path
        android:pathData="M50,35 L70,35"
        android:strokeWidth="1"
        android:strokeColor="#FFFFFF" />

    <!-- Left Highlight on Stem -->
    <path
        android:pathData="M50,35 L50,70"
        android:strokeWidth="0.5"
        android:strokeColor="#FFFFFF" />

    <!-- Glimmer Stars at the bottom -->
    <!-- Left Star -->
    <path
        android:pathData="M15,86 L17,90 L15,94 L13,90 Z"
        android:fillColor="#E0E0E0" />
    <!-- Right Star -->
    <path
        android:pathData="M93,86 L95,90 L93,94 L91,90 Z"
        android:fillColor="#A0A0A0" />

</vector>
